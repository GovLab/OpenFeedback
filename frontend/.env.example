# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values:
#   cp .env.example .env.local
# =============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8003

# Topic wording: must match the backend's TOPIC (permits or parks)
NEXT_PUBLIC_TOPIC=permits

# Label the dashboard "Sample Data" when showing made-up feedback
NEXT_PUBLIC_SAMPLE_DATA_NOTICE=false
