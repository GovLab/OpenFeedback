# =============================================================================
# Backend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values:
#   cp .env.example .env.local
# The defaults below match docker-compose.yml at the repo root.
# =============================================================================

# Application Environment
TOPIC=permits                      # permits, parks or housing (see README "Topics")

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Neo4j Database Configuration
AWS_NEO4J_URI=bolt://localhost:7687
AWS_NEO4J_USERNAME=neo4j
AWS_NEO4J_PASSWORD=localdevpassword

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openfeedback
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdevpassword

# Staff dashboard login
# STAFF_PASSWORD unlocks /govt and every staff-only API endpoint.
# SESSION_SECRET signs login tokens; any long random string works:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_PASSWORD=
SESSION_SECRET=

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your actual frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
